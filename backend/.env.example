# Copy to `.env` (never committed) and adjust. Every variable has a development default.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://striker:striker@localhost:5432/striker
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
# Signing key for HS256 tokens: at least 32 bytes; MUST be overridden outside local environments.
JWT_SECRET=change-me-in-production-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=480
# bcrypt cost factor for password hashes (12 is the production default).
BCRYPT_ROUNDS=12
