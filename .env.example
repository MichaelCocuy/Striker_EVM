# Variables del stack local (docker compose). Copia este archivo a `.env` para ajustarlas.
# Todas tienen un valor por defecto en docker-compose.yml, así que `docker compose up` funciona
# sin crear el `.env`.

# --- PostgreSQL ---
POSTGRES_USER=striker
POSTGRES_PASSWORD=striker
POSTGRES_DB=striker
POSTGRES_PORT=5432

# --- Backend ---
APP_ENV=development
BACKEND_PORT=8000
# Origen del frontend permitido por CORS. Con el stack de Compose el frontend llama al API en
# su mismo origen a través de nginx, así que CORS solo importa al usar el dev server de Vite.
CORS_ORIGINS=http://localhost:5173
# Obligatorio cambiarlo fuera del entorno local: firma los JWT.
JWT_SECRET=change-me-in-production

# --- Frontend ---
FRONTEND_PORT=5173
